# Copie este arquivo para ".env" (mesma pasta do pom.xml) e preencha a senha.
# O arquivo .env não vai para o GitHub (está no .gitignore).

ADMIN_USER=admin
# Obrigatória: mínimo de 8 caracteres. A aplicação não inicia sem ela.
ADMIN_PASSWORD=

